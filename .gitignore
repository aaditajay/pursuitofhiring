# Root .gitignore for Pursuit of Hiring fullstack project

# Frontend dependencies and builds
build/
frontend/node_modules/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/

# Backend dependencies and environments
backend/venv/
backend/.env
backend/__pycache__/
backend/*.pyc

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# System/Misc
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
